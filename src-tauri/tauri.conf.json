{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sotto",
  "version": "1.0.0",
  "identifier": "ai.sotto.dictation",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sotto",
        "width": 760,
        "height": 640,
        "minWidth": 680,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": {
      "../model/model.safetensors": "model/model.safetensors",
      "../model/tokenizer.json": "model/tokenizer.json",
      "../model/ternary.json": "model/ternary.json",
      "../model/config.json": "model/config.json",
      "../target/release/sotto-stt": "sotto-stt",
      "../LICENSE": "LICENSE"
    }
  }
}
